page {
  background: #f3eee6;
  color: #1c1916;
  font-family: "PingFang SC", "Hiragino Sans GB", "Noto Sans SC", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.page {
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
}

.kicker {
  font-size: 22rpx;
  letter-spacing: 0.24em;
  color: #6b655c;
}

.h1 {
  font-size: 56rpx;
  font-weight: 600;
  line-height: 1.2;
  margin-top: 16rpx;
}

.lead {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #6b655c;
  max-width: 560rpx;
}

.card {
  background: #fcfaf6;
  border-radius: 16rpx;
  box-shadow: 0 0 0 1rpx rgba(28, 25, 22, 0.06);
}

.muted {
  color: #6b655c;
}
