<view class="page" wx:if="{{brand}}">
  <view class="brand-head">
    <view class="avatar">{{brand.name[0]}}</view>
    <view>
      <view class="name">{{brand.name}}</view>
      <view class="muted">{{brand.name_en}} · {{brand.category}}</view>
    </view>
  </view>

  <view class="verdict {{brand.rest ? 'rest' : 'overtime'}}">
    <view class="kicker light">社区登记</view>
    <view class="verdict-title">{{brand.statusText}}</view>
    <view class="verdict-copy">{{brand.rest ? '社区记为双休。仅供参考，请自行判断。' : '社区记为未实行稳定双休。仅供参考，请自行判断。'}}</view>
  </view>

  <view wx:if="{{brand.note}}" class="note">{{brand.note}}</view>
  <view wx:if="{{brand.aliases}}" class="muted tiny">别名 {{brand.aliases}}</view>

  <view class="share card">
    <view class="share-row">
      <text>双休票占比</text>
      <text>{{brand.sharePct}}%</text>
    </view>
    <view class="bar"><view class="bar-fill" style="width: {{brand.sharePct}}%;"></view></view>
    <view class="muted tiny">{{brand.weekend_votes}} 双休 · {{brand.no_weekend_votes}} 非双休 · {{brand.total}} 票</view>
  </view>

  <block wx:if="{{alts.length}}">
    <view class="section-title">同类里记为双休的</view>
    <view class="muted section-lead">同是「{{brand.category}}」。是否更换，由你自己决定。</view>
    <view wx:for="{{alts}}" wx:key="id" class="row" data-id="{{item.id}}" bindtap="open">
      <view class="avatar sm">{{item.name[0]}}</view>
      <view class="row-main">
        <view class="row-top">
          <text class="row-name">{{item.name}}</text>
          <text class="badge rest-badge">双休</text>
        </view>
        <view class="muted">{{item.category}} · {{item.total}} 票</view>
      </view>
    </view>
  </block>

  <view class="vote-label">这是你了解的情况吗</view>
  <view class="vote-row">
    <button class="vote {{pickedVote === 'rest' ? 'on-rest' : ''}}" disabled="{{!!pickedVote}}" data-rest="true" bindtap="vote">双休 {{brand.weekend_votes}}</button>
    <button class="vote {{pickedVote === 'overtime' ? 'on-over' : ''}}" disabled="{{!!pickedVote}}" data-rest="false" bindtap="vote">非双休 {{brand.no_weekend_votes}}</button>
  </view>
</view>
