@import "../index/index.wxss";

.label { margin-top: 36rpx; margin-bottom: 12rpx; font-size: 26rpx; font-weight: 500; }
.field {
  background: #fcfaf6; border-radius: 16rpx; padding: 20rpx 24rpx; min-height: 80rpx;
  box-shadow: 0 0 0 1rpx rgba(28, 25, 22, 0.06);
}
.area {
  background: #fcfaf6; border-radius: 16rpx; padding: 20rpx 24rpx; min-height: 160rpx; width: auto;
  box-shadow: 0 0 0 1rpx rgba(28, 25, 22, 0.06);
}
.chip.on { background: #1c1916; color: #f3eee6; }
.submit {
  margin-top: 48rpx; background: #1c1916; color: #f3eee6; font-size: 30rpx;
}
